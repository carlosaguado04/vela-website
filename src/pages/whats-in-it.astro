---
import Base from "../layouts/Base.astro";
import { site } from "../site";

const title = "What’s in it";
const lead =
  "Free. Runs on Apple Silicon Macs, macOS 26 or later, with Safari’s engine.";

const features = [
  {
    title: "Address bar",
    body: "Press ⌘L when you want to go somewhere. It is not parked in the chrome.",
  },
  {
    title: "Pins",
    body: "Save up to 12 sites. Close a pin and it comes back to that address, not the last tab you left.",
  },
  {
    title: "Split View",
    body: "Two pages in one window. You pick the second page.",
  },
  {
    title: "Downloads",
    body: "Orza asks where to save. It does not write files in the background.",
  },
  {
    title: "Mini-player",
    body: "Control a video from another tab. Leave the page and it can go Picture-in-Picture.",
  },
  {
    title: "Spaces",
    body: "Separate cookies and logins, like profiles.",
  },
  {
    title: "Idle tabs",
    body: "Unused tabs unload to free memory. Coming back shows a snapshot, not a blank page.",
  },
  {
    title: "Reader",
    body: "Strip a page down to the article.",
  },
  {
    title: "Ads and trackers",
    body: "Blocked with macOS content rules, not an extension.",
  },
  {
    title: "Phishing and malware",
    body: "Warns if a site is on the OpenPhish or URLhaus lists.",
  },
  {
    title: "HTTPS-only",
    body: "HTTP is upgraded to HTTPS when it can.",
  },
  {
    title: "Permissions",
    body: "Location, notifications, downloads, and autoplay are asked per site.",
  },
  {
    title: "Keyboard",
    body: "Navigation has shortcuts, including Touch Bar on Macs that have one.",
  },
  {
    title: "Mise",
    body: "Mise can open an Orza window to a page, or a split with two pages, already in the slot you saved.",
  },
] as const;
---

<Base title={`${title} — ${site.name}`} description={lead}>
  <article class="inventory wrap">
    <header class="inventory-head">
      <h1>{title}</h1>
      <p>{lead}</p>
    </header>

    <div class="inventory-grid">
      {
        features.map((feature) => (
          <section class="feature">
            <h2>{feature.title}</h2>
            <p>{feature.body}</p>
          </section>
        ))
      }
    </div>
  </article>
</Base>
