---
import { site } from "../site";

const dest = "/#features";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Features — {site.name}</title>
    <meta http-equiv="refresh" content={`0;url=${dest}`} />
    <link rel="canonical" href={`${site.url}/#features`} />
    <script is:inline>location.replace("/#features");</script>
  </head>
  <body>
    <p><a href={dest}>Features</a></p>
  </body>
</html>
