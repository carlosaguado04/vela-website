---
import Base from "../layouts/Base.astro";
import { site } from "../site";

const title = "What’s in it";
const lead = "Apple Silicon, macOS 26+, free.";

const features = [
  { n: "01", title: "Pins" },
  { n: "02", title: "Split View" },
  { n: "03", title: "Mini-player" },
  { n: "04", title: "Spaces" },
  { n: "05", title: "Idle tabs" },
  { n: "06", title: "Reader" },
  { n: "07", title: "Ads & trackers" },
  { n: "08", title: "Phishing & malware" },
  { n: "09", title: "HTTPS-only" },
  {
    n: "10",
    title: "Mise",
    href: "https://usemise.dev",
    icon: "/favicons/mise.png",
  },
] as const;
---

<Base title={`${title} — ${site.name}`} description={lead}>
  <article class="inventory wrap">
    <header class="inventory-head">
      <h1>{title}</h1>
      <p>{lead}</p>
    </header>

    <div class="inventory-grid">
      {
        features.map((feature) => {
          const inner = (
            <>
              <div class="feature-top">
                <span class="feature-index" aria-hidden="true">
                  {feature.n}
                </span>
                {"icon" in feature && (
                  <img
                    class="feature-icon"
                    src={feature.icon}
                    width="36"
                    height="36"
                    alt=""
                    decoding="async"
                  />
                )}
              </div>
              <h2>{feature.title}</h2>
            </>
          );

          return "href" in feature ? (
            <a
              class="feature feature-mise"
              data-tilt
              href={feature.href}
              rel="noopener noreferrer"
              target="_blank"
            >
              {inner}
            </a>
          ) : (
            <article class="feature" data-tilt>
              {inner}
            </article>
          );
        })
      }
    </div>
  </article>

  <script>
    const motion = window.matchMedia("(prefers-reduced-motion: reduce)");

    function reset(card: HTMLElement) {
      card.style.setProperty("--rx", "0deg");
      card.style.setProperty("--ry", "0deg");
      card.style.setProperty("--lift", "0px");
    }

    function bind(card: HTMLElement) {
      const onMove = (event: PointerEvent) => {
        if (motion.matches) return;
        const rect = card.getBoundingClientRect();
        if (!rect.width || !rect.height) return;
        const px = (event.clientX - rect.left) / rect.width - 0.5;
        const py = (event.clientY - rect.top) / rect.height - 0.5;
        card.style.setProperty("--ry", `${px * 8}deg`);
        card.style.setProperty("--rx", `${-py * 6}deg`);
        card.style.setProperty("--lift", "-4px");
      };

      card.addEventListener("pointermove", onMove);
      card.addEventListener("pointerleave", () => reset(card));
    }

    document.querySelectorAll<HTMLElement>("[data-tilt]").forEach(bind);
    motion.addEventListener("change", () => {
      if (!motion.matches) return;
      document.querySelectorAll<HTMLElement>("[data-tilt]").forEach(reset);
    });
  </script>
</Base>
