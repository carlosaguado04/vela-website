---
import Base from "../layouts/Base.astro";
import Chrome from "../components/Chrome.astro";
import { jsonLd } from "../site";
---

<Base jsonLd={jsonLd}>
  <section class="hero">
    <div class="wrap hero-copy">
      <h1>A Mac browser for people who actually browse.</h1>
    </div>
    <div class="hero-stage wrap">
      <Chrome />
    </div>
  </section>

  <section class="beats" aria-label="What it is">
    <div class="wrap beats-grid">
      <article class="beat beat-cmd">
        <h2>⌘L</h2>
        <p>The address bar shouldn’t live in the chrome. Call it when you mean it.</p>
      </article>
      <article class="beat beat-pins">
        <h2>Pins</h2>
        <p>Bookmarks rot. A pin brings the page back home.</p>
      </article>
      <article class="beat beat-downloads">
        <h2>Downloads</h2>
        <p>The file shouldn’t vanish into a folder you forgot. It sits in a tray.</p>
      </article>
      <article class="beat beat-split">
        <h2>Split View</h2>
        <p>Two pages shouldn’t mean two windows. Pick them, split once.</p>
      </article>
      <article class="beat beat-mini">
        <h2>Mini-player</h2>
        <p>Change tabs and the video used to die. Mini-player, then PiP if you leave.</p>
      </article>
    </div>
  </section>

  <section class="closer" aria-label="Status">
    <div class="wrap">
      <h2>Still cooking.</h2>
      <p>Don’t ask for a TestFlight yet.</p>
    </div>
  </section>
</Base>
