---
import Base from "../layouts/Base.astro";
import Chrome from "../components/Chrome.astro";
import { jsonLd } from "../site";
---

<Base jsonLd={jsonLd}>
  <section class="hero">
    <div class="wrap hero-copy">
      <h1>A Mac browser. Free. Built with the people who use it.</h1>
    </div>
    <div class="hero-stage wrap">
      <div class="chrome-stage">
        <Chrome />
      </div>
    </div>
  </section>

  <section class="beats" aria-label="What it is">
    <div class="wrap beats-grid">
      <article class="beat">
        <h2>Free</h2>
        <p>You get a browser, not a waitlist.</p>
      </article>
      <article class="beat">
        <h2>Ask</h2>
        <p>Donate to put a feature on the list.</p>
      </article>
      <article class="beat">
        <h2>Vote</h2>
        <p>Once a month, users pick what we build next.</p>
      </article>
      <article class="beat">
        <h2>Build</h2>
        <p>We make that one with the person who asked.</p>
      </article>
    </div>
  </section>

  <section class="closer" aria-label="Status">
    <div class="wrap">
      <h2>Still cooking.</h2>
      <p>Don’t ask for a TestFlight yet.</p>
    </div>
  </section>
</Base>
