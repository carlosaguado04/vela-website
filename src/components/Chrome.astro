---
---

<figure
  class="chrome"
  aria-label="Orza window. Traffic lights and the address field sit in the sidebar. Pins stay put. A download lands in a tray."
>
  <div class="viewport">
    <div class="ntp">
      <p class="ntp-brand">ORZA</p>
      <p class="ntp-title">Where to?</p>
      <p class="ntp-hint">⌘L to search or enter an address</p>
    </div>

    <div class="dl-tray">
      <div class="dl">
        <span class="dl-file"></span>
        <span class="dl-meta">
          <span class="dl-name">brief.pdf</span>
          <span class="dl-bar"><i></i></span>
        </span>
      </div>
    </div>
  </div>

  <aside class="sidebar" aria-hidden="true">
    <div class="side-top">
      <div class="traffic">
        <i></i><i></i><i></i>
      </div>
      <span class="side-menu">
        <svg viewBox="0 0 16 16" width="14" height="14">
          <circle cx="3.5" cy="8" r="1.15" fill="currentColor"></circle>
          <circle cx="8" cy="8" r="1.15" fill="currentColor"></circle>
          <circle cx="12.5" cy="8" r="1.15" fill="currentColor"></circle>
        </svg>
      </span>
    </div>

    <div class="addr">
      <svg class="addr-ico is-dim" viewBox="0 0 16 16" width="12" height="12">
        <path
          d="M10.2 3.2 5.4 8l4.8 4.8"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
      <svg class="addr-ico is-dim" viewBox="0 0 16 16" width="12" height="12">
        <path
          d="M5.8 3.2 10.6 8 5.8 12.8"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
      <span class="addr-ph">Search or enter addr…</span>
      <span class="addr-shield"></span>
      <svg class="addr-ico addr-reload" viewBox="0 0 16 16" width="12" height="12">
        <path
          d="M12.6 8a4.6 4.6 0 1 1-1.35-3.25"
          fill="none"
          stroke="currentColor"
          stroke-width="1.55"
          stroke-linecap="round"></path>
        <path
          d="M12.7 2.8v3.1h-3.1"
          fill="none"
          stroke="currentColor"
          stroke-width="1.55"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </div>

    <div class="new-tab">
      <svg viewBox="0 0 12 12" width="11" height="11">
        <path
          d="M6 1.6v8.8M1.6 6h8.8"
          fill="none"
          stroke="currentColor"
          stroke-width="1.45"
          stroke-linecap="round"></path>
      </svg>
      New Tab
    </div>

    <div class="side-pins">
      <div class="side-row is-pinned">
        <img class="pin-favicon" src="/favicons/youtube.png" alt="" width="16" height="16" />
        YouTube
      </div>
      <div class="side-row is-pinned">
        <img class="pin-favicon" src="/favicons/x.png" alt="" width="16" height="16" />
        X
      </div>
    </div>
  </aside>
</figure>
