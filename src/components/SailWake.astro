<div class="sail-wake" aria-hidden="true"></div>

<script>
  const root = document.querySelector(".sail-wake");
  const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const LERP = 0.014;

  let x = 0;
  let y = 0;
  let tx = 0;
  let ty = 0;
  let raf = 0;
  let following = false;

  function rest() {
    return {
      x: window.innerWidth * 0.42,
      y: window.innerHeight * 0.28,
    };
  }

  function apply() {
    if (!(root instanceof HTMLElement)) return;
    root.style.setProperty("--glow-x", `${x}px`);
    root.style.setProperty("--glow-y", `${y}px`);
  }

  function tick() {
    x += (tx - x) * LERP;
    y += (ty - y) * LERP;
    apply();
    if (Math.hypot(tx - x, ty - y) > 0.4) {
      raf = requestAnimationFrame(tick);
    } else {
      x = tx;
      y = ty;
      apply();
      raf = 0;
    }
  }

  function kick() {
    if (!raf) raf = requestAnimationFrame(tick);
  }

  function onMove(event: PointerEvent) {
    following = true;
    tx = event.clientX;
    ty = event.clientY;
    kick();
  }

  function onResize() {
    if (motion.matches || !following) {
      const r = rest();
      x = tx = r.x;
      y = ty = r.y;
      apply();
    }
  }

  function stop() {
    cancelAnimationFrame(raf);
    raf = 0;
    window.removeEventListener("pointermove", onMove);
    window.removeEventListener("resize", onResize);
  }

  function start() {
    if (!(root instanceof HTMLElement)) {
      stop();
      return;
    }
    stop();
    following = false;
    const r = rest();
    x = tx = r.x;
    y = ty = r.y;
    apply();
    window.addEventListener("resize", onResize);
    if (motion.matches) return;
    window.addEventListener("pointermove", onMove, { passive: true });
  }

  start();
  motion.addEventListener("change", start);
</script>
