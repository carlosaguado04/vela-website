---
import { features } from "../site";
---

<section class="inventory" id="features" aria-labelledby="features-title">
  <header class="inventory-head">
    <h2 id="features-title">Features</h2>
  </header>

  <ol class="index">
    {
      features.map((feature) => {
        const tipId = `feature-tip-${feature.n}`;
        const icon = "icon" in feature ? feature.icon : undefined;
        const row = (
          <>
            <span class="index-n" aria-hidden="true">{feature.n}</span>
            <span class="index-t">
              {icon && (
                <img
                  class="index-icon"
                  src={icon}
                  width="18"
                  height="18"
                  alt=""
                  decoding="async"
                />
              )}
              {feature.title}
            </span>
            <span class="index-tip" id={tipId} role="tooltip">{feature.tip}</span>
          </>
        );

        return (
          <li>
            {"href" in feature ? (
              <a
                href={feature.href}
                rel="noopener noreferrer"
                target="_blank"
                aria-describedby={tipId}
              >
                {row}
              </a>
            ) : (
              <div class="index-row" tabindex="0" aria-describedby={tipId}>
                {row}
              </div>
            )}
          </li>
        );
      })
    }
  </ol>
</section>
